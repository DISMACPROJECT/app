# API Configuration
EXPO_PUBLIC_API_BASE_URL=https://script.google.com/a/macros/dismac.com.ec/s/AKfycbx_4VowVnwBmdKn2T7Bj4EkzVLfY7NYGxuTeTOifQUXEV6LYvdcxTRWKZWFlVtFruYilQ/exec
EXPO_PUBLIC_API_TIMEOUT=30000

# Google Drive Configuration
# ID de la carpeta principal en Google Drive donde se almacenan las fotos
EXPO_PUBLIC_DRIVE_PROJECT_FOLDER={FOLDER_ID}

# Feature Flags
EXPO_PUBLIC_ENABLE_BIOMETRIC=true
EXPO_PUBLIC_ENABLE_GPS=true
EXPO_PUBLIC_ENABLE_OFFLINE_MODE=true

# Data Retention (in days)
EXPO_PUBLIC_PHOTO_RETENTION_DAYS=60
EXPO_PUBLIC_TASK_RETENTION_DAYS=90

# Logging
EXPO_PUBLIC_LOG_LEVEL=info

# Error Tracking (Sentry)
EXPO_PUBLIC_SENTRY_DSN=
